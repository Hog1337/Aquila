# Лимиты оперативной памяти контейнеров (docker: mem_limit) и другие несекретные настройки стека.
# Единое место для всего решения: `./run.sh` создаёт .env из этого файла при первом запуске (существующий не трогает)
# и экспортирует значения, так что они действуют на compose-файлы всех сервисов.
# Формат Docker: 512m, 1g, 4g. Изменение вступает в силу при следующем `./run.sh`: контейнер пересоздаётся.
# Секреты здесь не хранятся: они в postgres/.env, vector/.env, storage/.env.
#
# Значения рассчитаны на хост с 8 ГБ RAM: сумма лимитов около 7,6 ГБ, но это потолки, а не резервы: в простое стек занимает
# около 1,3 ГБ, пики контейнеров вместе не совпадают. У inference запас (4 ГБ) на модель без GPU и большие кадры. Основа значений: пики контейнеров
# (memory.peak в cgroup) на aquila при импорте галереи в 1119 кадров: inference 1,7 ГБ на старте (0,75 в работе),
# SeaweedFS 1,0 ГБ (из них реальной памяти 0,16, остальное кэш файлов), backend 0,26, Qdrant 0,12, Postgres 0,08, frontend 0,02.
# Хост побольше: поднимайте лимиты, прежде всего SEAWEEDFS_MEM_LIMIT и QDRANT_MEM_LIMIT (для галереи порядка 10^6 объектов).
INFERENCE_MEM_LIMIT=4g
SEAWEEDFS_MEM_LIMIT=1536m
QDRANT_MEM_LIMIT=1g
BACKEND_MEM_LIMIT=2g
POSTGRES_MEM_LIMIT=512m
FRONTEND_MEM_LIMIT=128m

# Дефолтный порог отказа (backend, DEFAULT_THRESHOLD): используется, только если в БД ещё нет сохранённого порога
# (reid.current_threshold пуст).
DEFAULT_THRESHOLD=0.87
