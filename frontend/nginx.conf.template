# Шаблон nginx: ${API_UPSTREAM} и ${NGINX_RESOLVER} подставляются при старте контейнера.
# Остальные $-переменные (например $uri) entrypoint не трогает.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    # Проверка живости для docker healthcheck и Jenkins
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Backend инференса и Swagger (OpenAPI, ТЗ п.6). Имя резолвится при запросе,
    # поэтому фронтенд стартует и без запущенного backend (тогда /api отвечает 502).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location ~ ^/(api/|docs|redoc|openapi\.json) {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Кадры и архивы галереи загружаются в исходном разрешении; инференс может занимать время.
        # Тело запроса не буферизуем: иначе nginx складывает его в /tmp (tmpfs, входит в память контейнера).
        client_max_body_size 15g;
        proxy_request_buffering off;
        # check-images может проверять тысячи image_id через S3; clear-gallery — удалять пачками
        proxy_read_timeout 300s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 30s;
    }

    # Файлы в assets/ имеют хэш в имени и не меняются — кэшируем надолго
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy same-origin always;
        try_files $uri =404;
    }

    # index.html не кэшируем, чтобы обновления доезжали сразу
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy same-origin always;
        try_files $uri $uri/ /index.html;
    }
}
