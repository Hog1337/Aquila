# Скопируйте в .env и замените пароли. Значения: только латиница и цифры.
# `./run.sh` создаёт этот файл сам при первом запуске (в том числе на aquila при деплое из Jenkins) со случайными значениями.
POSTGRES_VERSION=17
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# База и администратор: только для миграций и обслуживания, сервисам не отдавайте
POSTGRES_DB=reid
POSTGRES_ADMIN_USER=reidadmin
POSTGRES_ADMIN_PASSWORD=change-me-admin-password

# Роль backend инференса: чтение и запись данных схемы reid, без права менять структуру БД
POSTGRES_APP_USER=reidbackend
POSTGRES_APP_PASSWORD=change-me-app-password

# Размерность эмбеддинга (та же, что в vector/.env.example); задаёт ограничение длины массива embedding в истории запросов
EMBEDDING_DIM=2048
