# Скопируйте в .env и замените ключ. Значения: только латиница и цифры.
# `./run.sh` создаёт этот файл сам при первом запуске (в том числе на aquila при деплое из Jenkins) со случайными значениями.
QDRANT_VERSION=v1.19.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_BIND=127.0.0.1

# Ключ API: передаётся в заголовке api-key (REST) или метаданных api-key (gRPC). Его получает backend инференса.
QDRANT_API_KEY=change-me-qdrant-key

# Коллекция галереи и размерность эмбеддинга (текущая модель JDNFV_MASKED_FT даёт 2048; при смене модели менять здесь)
QDRANT_COLLECTION=gallery
EMBEDDING_DIM=2048

# Хранение векторов: none (float32 как есть, точный ответ) или scalar (int8 в RAM + rescoring float32 с диска,
# в 4 раза меньше RAM, рекомендуется для галереи порядка 10^6 объектов)
QDRANT_QUANTIZATION=none

# Параметры HNSW-индекса: m (связность графа) и ef_construct (глубина поиска при построении)
HNSW_M=16
HNSW_EF_CONSTRUCT=128
