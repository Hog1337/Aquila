# Скопируйте в .env и замените ключи. Значения: только латиница и цифры (они попадают в s3.json без экранирования).
# `./run.sh` создаёт этот файл сам при первом запуске (в том числе на aquila при деплое из Jenkins) со случайными значениями.
SEAWEEDFS_VERSION=4.47
S3_BUCKET=gallery
S3_PORT=8333
S3_BIND=127.0.0.1

# Ключ backend инференса: чтение/запись только в бакет галереи
S3_APP_ACCESS_KEY=reidbackend
S3_APP_SECRET_KEY=change-me-app-secret

# Административный ключ: управление бакетами, не отдавайте его сервисам
S3_ADMIN_ACCESS_KEY=reidadmin
S3_ADMIN_SECRET_KEY=change-me-admin-secret
